--- !u!114 &1481602558
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1481602557}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09075d42961b326418157e674470fada, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TareasManager
  tareas:
  - nombre: Alimentar a los caballos
    lugarPancho: {fileID: 28776267}
    instruccion: "Los caballos tienen hambre. Coge la bolsa de heno que est\xE1 junto
      al granero y ll\xE9vala al comedero"
    felicitacion: "\xA1Barrigas felices! Ahora ve al gallinero, all\xE1 te espero"
    activarAlCompletar:
    - {fileID: 1184867976}
    completada: 0
  - nombre: Llevar las gallinas al gallinero
    lugarPancho: {fileID: 47241121}
    instruccion: "\xA1Las gallinas se escaparon! C\xF3gelas una por una y ll\xE9valas
      al gallinero"
    felicitacion: "\xA1Todas en casa! Ahora ve donde Lola, la vaca"
    activarAlCompletar:
    - {fileID: 140401729}
    completada: 0
  - nombre: "Orde\xF1ar a Lola"
    lugarPancho: {fileID: 604552481}
    instruccion: Lola tiene leche fresquita. Coge el balde y ponlo debajo de ella.
    felicitacion: "\xA1Qu\xE9 rica leche! Ahora vamos a los surcos a sembrar"
    activarAlCompletar:
    - {fileID: 2069394868}
    completada: 0
  - nombre: Sembrar las semillas
    lugarPancho: {fileID: 1734786772}
    instruccion: Coge la bolsa de semillas de la mesa y mira cada uno de los 4 surcos
      para sembrar.
    felicitacion: "\xA1Bien sembrado! Ahora vamos al huerto."
    activarAlCompletar:
    - {fileID: 1716397327}
    completada: 0
  - nombre: Cosechar los tomates
    lugarPancho: {fileID: 1135682426}
    instruccion: "Recoge los 15 tomates de los \xE1rboles y ponlos en la canasta"
    felicitacion: "\xA1Qu\xE9 cosecha! Ahora vamos a la camioneta"
    activarAlCompletar:
    - {fileID: 413844662}
    completada: 0
  - nombre: Cargar la camioneta
    lugarPancho: {fileID: 191888935}
    instruccion: Lleva la leche y los tomates de la mesa a la camioneta
    felicitacion: 
    activarAlCompletar:
    - {fileID: 179252061}
    completada: 0
  monedasPorTarea: 10
  textoTablero: {fileID: 0}
  textoMonedas: {fileID: 3927650}
  pancho: {fileID: 958350639}
  textoPancho: {fileID: 1616075988}
  mensajeInicial: "\xA1Buenos d\xEDas! Soy Pancho. Hoy es la feria y Don Tom\xE1s
    nos necesita. Mira el tablero para ver tus tareas. \xA1Te espero donde los caballos!"
  mensajeFinal: "\xA1Todo listo! \xA1Nos vamos a la feria!"
  esperaAntesDeMover: 5
  activarAlTerminarTodo:
