  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TareasManager
  tareas:
  - nombre: Mirar
    lugarPancho: {fileID: 0}
    instruccion: 
    felicitacion: "\xA1Muy bien! En este juego todo se escoge as\xED: mirando"
    activarAlCompletar: []
    completada: 0
  - nombre: Moverse
    lugarPancho: {fileID: 0}
    instruccion: "\xBFVes ese c\xEDrculo amarillo en el piso? Cada vez que veas uno,
      m\xEDralo y te llevar\xE1 hasta all\xE1. Ve hasta el \xE1rbol."
    felicitacion: "\xA1Perfecto! As\xED te mover\xE1s por toda la granja."
    activarAlCompletar: []
    completada: 0
  - nombre: Coger y poner
    lugarPancho: {fileID: 0}
    instruccion: "Para coger algo, m\xEDralo hasta que el c\xEDrculo se llene. Coge
      un tomate del \xE1rbol y luego mira la canasta para dejarlo adentro."
    felicitacion: "\xA1Excelente cosecha! Ahora ve a la mesa de las semillas."
    activarAlCompletar: []
    completada: 0
  - nombre: Usar un objeto
    lugarPancho: {fileID: 0}
    instruccion: Algunas cosas se usan sobre otras. Coge la bolsa de semillas y luego
      mira la tierra para sembrar.
    felicitacion: 
    activarAlCompletar: []
    completada: 0
  monedasPorTarea: 0
  textoTablero: {fileID: 0}
  textoMonedas: {fileID: 0}
  pancho: {fileID: 1090822695}
  textoPancho: {fileID: 330414400}
  mensajeInicial: "\xA1Hola! Soy Pancho, el ayudante de Don Tom\xE1s. Antes de ir
    a la granja te ense\xF1ar\xE9 lo b\xE1sico. Mira el bot\xF3n Empezar y qu\xE9date
    mir\xE1ndolo: ver\xE1s un c\xEDrculo que se va llenando. Cuando se llene, el
    bot\xF3n se activa."
  mensajeFinal: "\xA1Aprendiste todo! Ma\xF1ana muy temprano empieza tu d\xEDa en
    la granja. All\xE1 tendr\xE1s un tablero con todas las labores. Cuando quieras,
    mira el bot\xF3n \xA1Vamos a la granja!"
  esperaAntesDeMover: 5
